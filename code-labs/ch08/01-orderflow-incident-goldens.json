        {"name": "opa_policy_check", "args": {"res": "db-secret"}},
        {"name": "audit_event_log", "args": {"policy": "ASI03"}}
      ],
      "retrieval_context": [
        "OPA denied read of prod/db-secret under policy ASI03.",
        "Audit log recorded status=DENIED for orderflow-sre."
      ],
      "expected_facts": ["denied", "ASI03", "DENIED"]
    },
    {
      "golden_id": "G-06",
      "incident": "webhook_502_surge",
