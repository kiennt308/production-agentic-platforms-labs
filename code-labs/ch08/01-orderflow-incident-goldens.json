      "retrieval_context": [
        "Prometheus reports checkout-api p99=1850ms and 5xx=4.2%.",
        "OTel trace 4bf9 shows timeout on downstream redis-cart."
      ],
      "expected_facts": ["1850ms", "4bf9", "redis-cart"]
    },
    {
      "golden_id": "G-02",
      "incident": "aurora_lock_contention",
      "input": "Diagnose orders_tx write stalls in Aurora primary.",
      "expected_tools": [
        {"name": "inspect_aurora_locks", "args": {"db": "orders_tx"}},
        {"name": "read_pg_stat", "args": {"pid": 4412}}
      ],
      "retrieval_context": [
        "Aurora orders_tx shows blocking lock held by pid=4412.",
        "pg_stat confirms pid=4412 idle-in-transaction for 410s."
      ],
      "expected_facts": ["orders_tx", "4412", "410s"]
    },
    {
      "golden_id": "G-03",
      "incident": "poisoned_log_injection",
