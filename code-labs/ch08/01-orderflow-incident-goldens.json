      "retrieval_context": [
        "ArgoCD diff shows checkout-v4.2 OutOfSync replicas=2 vs 4.",
        "Helm values specify replicas=4 in orderflow-prod."
      ],
      "expected_facts": ["OutOfSync", "replicas=2", "replicas=4"]
    },
    {
      "golden_id": "G-05",
      "incident": "secret_read_block",
